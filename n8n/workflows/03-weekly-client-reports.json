{
  "name": "RC \u00b7 Weekly client reports (Mon 9:00 IST)",
  "nodes": [
    {
      "id": "1",
      "name": "Every Monday 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Active clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.RC_API_URL }}/v1/clients",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "active"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RC_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Lists active clients through the API (service token, scoped to DEFAULT_ORG_ID by row-level security). No database credentials in n8n."
    },
    {
      "id": "4",
      "name": "One item per client",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Draft report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RC_API_URL }}/v1/agents/reporting/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RC_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ periodStart: $now.minus({days:7}).toFormat('yyyy-MM-dd'), periodEnd: $now.minus({days:1}).toFormat('yyyy-MM-dd') }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Monday 9:00": {
      "main": [
        [
          {
            "node": "Active clients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Active clients": {
      "main": [
        [
          {
            "node": "One item per client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per client": {
      "main": [
        [
          {
            "node": "Draft report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  }
}
