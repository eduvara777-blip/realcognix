# ---------- RealCognix OS — copy to .env and edit ----------
NODE_ENV=production
PORT=4000
PUBLIC_API_URL=http://localhost:4000
# Generate: openssl rand -hex 24
API_TOKEN=change-me-api-token
INTAKE_SHARED_SECRET=change-me-intake-secret
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# ---------- Sign-in ----------
# local = built-in email + password; oidc = Keycloak / Supabase / any OIDC issuer (RS256 via JWKS)
AUTH_PROVIDER=local
# Required in production for AUTH_PROVIDER=local. Generate: openssl rand -hex 32
JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# LOGIN_MAX_ATTEMPTS=5          # failed tries per email+IP per LOGIN_WINDOW_MINUTES
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCK_THRESHOLD=10       # consecutive failures before the account locks for LOGIN_LOCK_MINUTES
# LOGIN_LOCK_MINUTES=15
# OIDC (only when AUTH_PROVIDER=oidc); users.auth_subject must hold each user's "sub"
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Browser origins allowed to call the API (comma-separated). Empty = any origin (dev only).
CORS_ORIGINS=http://localhost:8080
# Dev only: first password for a seeded user, read by `npm run set-password` (or you get a prompt).
# Never commit a real value. Pick your own; there is no default password.
# DEV_ADMIN_PASSWORD=

POSTGRES_USER=realcognix
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=realcognix

# ---------- AI (LiteLLM proxy; see infra/litellm/config.yaml) ----------
LLM_PROVIDER=openai_compatible
LLM_API_KEY=sk-change-me-litellm
LLM_MODEL=default
LLM_EMBED_MODEL=embed
LLM_SCORING_ENABLED=false
# Optional free-tier keys
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- WhatsApp Cloud API (console = log only, no sends) ----------
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-wa-verify
WHATSAPP_TEMPLATE_LANG=en

# ---------- Email (dev: Mailpit at http://localhost:8025) ----------
EMAIL_PROVIDER=smtp
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RealCognix <hello@realcognix.com>

# ---------- Meta lead ads ----------
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-verify
META_PAGE_ACCESS_TOKEN=

# ---------- Ads reporting (off until keys exist) ----------
ADS_META_ENABLED=false
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
ADS_GOOGLE_ENABLED=false
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_OAUTH_ACCESS_TOKEN=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/app/storage

# ---------- Sales rules (IST) ----------
SLA_MINUTES=5
SLA_MAX_REASSIGNS=2
QUIET_HOURS_START=21
QUIET_HOURS_END=9
CADENCE_DAYS=0,1,3,7,14,30

# ---------- n8n ----------
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-n8n-key
N8N_PUBLIC_URL=http://localhost:5678/
